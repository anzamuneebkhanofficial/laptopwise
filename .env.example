# ─── Dual AI Verification Engine ──────────────────────────────
# Replace with your own API keys before running the application

# 1. Google Gemini AI API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEN_MODEL=gemini-3.6-flash

# 2. Groq AI API Key (Get from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── Application Server URL ────────────────────────────────────
# Set this to your live production domain (e.g. https://laptopwise.com or https://your-app.vercel.app)
# When set, downloaded scanner files will automatically target this server URL.
# If left empty, the server automatically detects the domain from incoming web requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000
